{
  "name": "brook",
  "productName": "Brook",
  "version": "1.0.0",
  "description": "Brook — Your music lives on. An offline-first desktop music player.",
  "author": "Chenna Sai Charan",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VELA_DEV_SERVER=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node tests/e2e/run-e2e.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "pack": "vite build && electron-builder --win --dir",
    "dist": "vite build && electron-builder --win nsis",
    "brand": "electron scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.55.0",
    "music-metadata": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.brook.player",
    "productName": "Brook",
    "copyright": "Brook",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "build/tray.ico",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brook"
    },
    "fileAssociations": [],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
